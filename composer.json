{
    "name": "bleksak/mago-pdo-extension",
    "description": "Mago PDO extension for validating SQL queries and inferring their return type.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Bleksak\\MagoPdoExtension\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bleksak\\MagoPdoExtension\\Tests\\": "tests/Unit/"
        }
    },
    "authors": [
        {
            "name": "Jiri Velek",
            "email": "jiri.velek@yahoo.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "carthage-software/mago": "^1.47"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    }
}
